# Copie para .env (ou configure no painel da hospedagem). Nenhuma destas variáveis é secreta.

# Porta do servidor (a maioria das hospedagens define sozinha)
PORT=3000

# Pasta do banco de dados. Em produção, aponte para um DISCO PERSISTENTE (volume),
# senão os saldos somem a cada novo deploy.
DATA_DIR=/data

# Endereço público do site (opcional, reforça a proteção contra requisições de outros sites)
PUBLIC_ORIGIN=https://seudominio.com.br

# Cookie de login seguro. Deixe sem valor: o servidor liga sozinho quando o site é acessado por HTTPS.
# 1 = sempre ligado, 0 = sempre desligado (só para testes).
# COOKIE_SECURE=
